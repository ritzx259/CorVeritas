# Optional shell environment settings. Copy to .env, edit, then load in the
# terminal before starting the backend: set -a; source .env; set +a
# No patient inputs are written to this file.

CORVERITAS_DEFAULT_MODEL=random_forest
CORVERITAS_THRESHOLD_MLP=0.5
CORVERITAS_THRESHOLD_CNN=0.5
CORVERITAS_THRESHOLD_RANDOM_FOREST=0.5
CORVERITAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: restrict loading to one trusted directory. Relative paths resolve
# from frontend_corveritas2. When unset, local models/ takes precedence over
# the repository's existing ../models/ artifacts.
# CORVERITAS_MODEL_DIR=models

# Optional Stage 2 overrides. Relative paths resolve from the CorVeritas root.
# Stage 2 runs in its own environment; Stage 1 never imports Torch.
# CORVERITAS_STAGE2_MODEL_DIR=models_stage2/models
# CORVERITAS_STAGE2_PYTHON=models_stage2/.venv/bin/python
